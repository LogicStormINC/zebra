# Reviewed integration fixes atop the frozen native Rabbit image.
ARG E1_BASE_IMAGE=zebra-ha-e1-rabbit:9e3cef3b
FROM ${E1_BASE_IMAGE}
COPY --chown=65532:65532 packages/agent-storage/src/agent_storage/postgres/command_runtime_cleanup.py /app/packages/agent-storage/src/agent_storage/postgres/command_runtime_cleanup.py
COPY --chown=65532:65532 packages/agent-storage/src/agent_storage/postgres/force_stop_recovery.py /app/packages/agent-storage/src/agent_storage/postgres/force_stop_recovery.py
COPY --chown=65532:65532 packages/agent-runtime/src/agent_runtime/force_stop_cleanup.py /app/packages/agent-runtime/src/agent_runtime/force_stop_cleanup.py
COPY --chown=65532:65532 docker/migrate.py /app/docker/migrate.py
COPY --chown=65532:65532 packages/agent-storage/src/agent_storage/postgres/client_effect_recovery.py /app/packages/agent-storage/src/agent_storage/postgres/client_effect_recovery.py
COPY --chown=65532:65532 apps/worker/src/zebra_agent_worker/cloud_composition.py /app/apps/worker/src/zebra_agent_worker/cloud_composition.py
COPY --chown=65532:65532 apps/worker/src/zebra_agent_worker/loop.py /app/apps/worker/src/zebra_agent_worker/loop.py
COPY --chown=65532:65532 apps/worker/src/zebra_agent_worker/main.py /app/apps/worker/src/zebra_agent_worker/main.py
COPY --chown=65532:65532 apps/worker/src/zebra_agent_worker/session_process_child.py /app/apps/worker/src/zebra_agent_worker/session_process_child.py
COPY --chown=65532:65532 packages/agent-integrations/src/agent_integrations/worker_budget.py /app/packages/agent-integrations/src/agent_integrations/worker_budget.py
COPY --chown=65532:65532 packages/agent-integrations/src/agent_integrations/bounded_model_dns.py /app/packages/agent-integrations/src/agent_integrations/bounded_model_dns.py
COPY --chown=65532:65532 packages/agent-core/src/agent_core/domain/task_bindings.py /app/packages/agent-core/src/agent_core/domain/task_bindings.py
COPY --chown=65532:65532 apps/api/src/zebra_agent_api/session_binding.py /app/apps/api/src/zebra_agent_api/session_binding.py
COPY --chown=65532:65532 packages/agent-storage/src/agent_storage/postgres/task_admission.py /app/packages/agent-storage/src/agent_storage/postgres/task_admission.py
COPY --chown=65532:65532 apps/host_grant_broker/src/zebra_host_grant_broker/grant_minting.py /app/apps/host_grant_broker/src/zebra_host_grant_broker/grant_minting.py
COPY --chown=65532:65532 packages/agent-storage/src/agent_storage/postgres/force_stop_executors.py /app/packages/agent-storage/src/agent_storage/postgres/force_stop_executors.py
COPY --chown=65532:65532 tests/compose/cloud_ha_e1/child_profile_sitecustomize.py /app/.venv/lib/python3.12/site-packages/sitecustomize.py
COPY --chown=65532:65532 packages/agent-storage/src/agent_storage/postgres/workspaces.py /app/packages/agent-storage/src/agent_storage/postgres/workspaces.py
COPY --chown=65532:65532 packages/agent-core/src/agent_core/domain/runtime_bundle_catalog.py /app/packages/agent-core/src/agent_core/domain/runtime_bundle_catalog.py
ARG E1_SOURCE_COMMIT
LABEL org.opencontainers.image.revision=${E1_SOURCE_COMMIT}

# ponytail: compile only image-owned code; source hashes still reject stale caches.
USER root
RUN python -m compileall -q -f --invalidation-mode checked-hash \
    /app/apps /app/packages /app/.venv/lib/python3.12/site-packages /usr/local/lib/python3.12
USER zebra
