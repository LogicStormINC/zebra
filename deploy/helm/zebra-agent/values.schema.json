{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "image",
    "profile",
    "deploymentNamespace",
    "runtimeClassName",
    "runtimeImage",
    "workspaceQuota",
    "secrets",
    "config"
  ],
  "properties": {
    "databaseBudget": {
      "type": "object",
      "required": [
        "pool",
        "normal",
        "read",
        "control",
        "probe",
        "execution_slots",
        "enabled",
        "max_connections",
        "server_reserved",
        "external",
        "fleet"
      ],
      "additionalProperties": false,
      "properties": {
        "pool": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "normal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "read": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "probe": {"type": "integer", "minimum": 1, "maximum": 32},
        "control": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "execution_slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "enabled": {
          "type": "boolean"
        },
        "max_connections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262143
        },
        "receipt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "server_reserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 262143
        },
        "external": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262143
        },
        "executor_limits": {
          "type": "object",
          "required": ["pool", "normal", "read", "control", "probe"],
          "additionalProperties": false,
          "properties": {
            "pool": {"type": "integer", "minimum": 1, "maximum": 32},
            "normal": {"type": "integer", "minimum": 1, "maximum": 32},
            "read": {"type": "integer", "minimum": 1, "maximum": 32},
            "control": {"type": "integer", "minimum": 1, "maximum": 32},
            "probe": {"type": "integer", "minimum": 1, "maximum": 32}
          }
        },
        "fleet": {
          "type": "object",
          "required": [
            "api",
            "worker",
            "executor",
            "cleanup",
            "scheduler"
          ],
          "additionalProperties": false,
          "properties": {
            "api": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32768
            },
            "worker": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32768
            },
            "executor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32768
            },
            "cleanup": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32768
            },
            "scheduler": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32768
            }
          }
        }
      }
    },
    "worker": {
      "$ref": "#/$defs/workload",
      "properties": {
        "executionSlots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    },
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["IfNotPresent", "Always"]}
      }
    },
    "profile": {"type": "string", "enum": ["cloud", "production"]},
    "deploymentNamespace": {"type": "string", "minLength": 1},
    "runtimeClassName": {"const": "gvisor"},
    "runtimeImage": {"type": "string", "minLength": 1},
    "workspaceQuota": {
      "type": "object",
      "required": ["enabled"],
      "properties": {"enabled": {"const": true}}
    },
    "serviceAccount": {
      "type": "object",
      "required": ["create"],
      "properties": {"create": {"type": "boolean"}, "name": {"type": "string"}}
    },
    "secrets": {
      "type": "object",
      "required": ["databaseUrl", "s3", "liveRedisUrl", "memorySigningKey"],
      "properties": {
        "databaseUrl": {
          "type": "object",
          "required": ["name", "key"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "key": {"type": "string", "minLength": 1}
          }
        },
        "s3": {
          "type": "object",
          "required": ["name", "accessKeyKey", "secretKeyKey"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "accessKeyKey": {"type": "string", "minLength": 1},
            "secretKeyKey": {"type": "string", "minLength": 1}
          }
        },
        "liveRedisUrl": {
          "type": "object",
          "required": ["name", "key"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "key": {"type": "string", "minLength": 1}
          }
        },
        "memorySigningKey": {
          "type": "object",
          "required": ["name", "key"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "key": {"type": "string", "minLength": 1}
          }
        },
        "apiAuthToken": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "key": {"type": "string"}
          }
        }
      }
    },
    "config": {
      "type": "object",
      "required": [
        "authorityIssuer",
        "historyScopeNamespace",
        "continuationScopeNamespace",
        "s3Endpoint",
        "s3Bucket",
        "s3Region",
        "s3KeyPrefix"
      ],
      "properties": {
        "authorityIssuer": {"type": "string", "minLength": 1},
        "historyScopeNamespace": {"type": "string", "minLength": 1},
        "continuationScopeNamespace": {"type": "string", "minLength": 1},
        "s3Endpoint": {"type": "string", "minLength": 1},
        "s3Bucket": {"type": "string", "minLength": 1},
        "s3Region": {"type": "string", "minLength": 1},
        "s3KeyPrefix": {"type": "string", "minLength": 1},
        "liveStreamMaxLength": {"type": "integer", "minimum": 1},
        "liveStreamKeyPrefix": {"type": "string", "minLength": 1}
      }
    },
    "api": {"$ref": "#/$defs/workload"},
    "worker": {"$ref": "#/$defs/workload"},
    "migration": {"type": "object"}
  },
  "$defs": {
    "workload": {
      "type": "object",
      "required": ["replicas", "resources"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 2},
        "resources": {"type": "object"}
      }
    }
  }
}
