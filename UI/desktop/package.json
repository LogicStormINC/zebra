{
  "name": "@zebra-agent/desktop-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.28.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check:runtime": "node --experimental-strip-types checks/runtime-connection.check.ts",
    "check:live": "node --experimental-strip-types checks/live-session.check.ts",
    "check:delivery": "node --experimental-strip-types checks/session-delivery.check.ts",
    "preview": "vite preview",
    "tauri:dev": "CARGO_HOME=$PWD/.cargo-home tauri dev",
    "tauri:build": "CARGO_HOME=$PWD/.cargo-home tauri build",
    "tauri:check": "cd src-tauri && CARGO_HOME=$PWD/../.cargo-home cargo check"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@ant-design/x": "^2.8.0",
    "@tanstack/react-query": "^5.85.5",
    "@tauri-apps/api": "^2.8.0",
    "antd": "^5.27.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@ant-design/x-sdk": "^2.8.0",
    "@ant-design/x-markdown": "^2.8.0",
    "antd-style": "^3.7.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "vite": "^7.1.2"
  },
  "volta": {
    "node": "22.17.0"
  }
}
