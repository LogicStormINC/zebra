{
  "name": "@zebra-agent/desktop-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.28.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check:runtime": "node --experimental-strip-types checks/runtime-connection.check.ts",
    "check:live": "node --experimental-strip-types checks/live-session.check.ts",
    "check:approval": "node --experimental-strip-types checks/approval-continuation.check.ts",
    "check:clarification": "node --experimental-strip-types checks/clarification-continuation.check.ts",
    "check:launch": "node --experimental-strip-types checks/task-launch-config.check.ts",
    "check:index": "node --experimental-strip-types checks/workspace-session-reconciliation.check.ts",
    "check:selection": "node --experimental-strip-types checks/workspace-selection.check.ts",
    "check:projects": "node --experimental-strip-types checks/workspace-projects.check.ts",
    "check:plan": "node --experimental-strip-types checks/task-plan.check.ts",
    "check:search-approval": "node --experimental-strip-types checks/web-search-approval.check.ts",
    "check:attachments": "node --experimental-strip-types checks/text-attachments.check.ts",
    "check:mcp": "node --experimental-strip-types checks/mcp-capabilities.check.ts",
    "check:mcp-prompt": "node --experimental-strip-types checks/mcp-prompt-launch.check.ts",
    "check:session-config-surface": "node --experimental-strip-types checks/session-config-surface.check.ts",
    "check:session-status": "node --experimental-strip-types checks/session-status.check.ts",
    "check:timeline": "node --experimental-strip-types checks/session-timeline.check.ts",
    "check:runtime-activity": "node --experimental-strip-types checks/runtime-activity.check.ts",
    "check:streaming": "node --experimental-strip-types checks/streaming-messages.check.ts",
    "check:handoff": "node --experimental-strip-types checks/session-handoff.check.ts",
    "check:task-continuity": "node --experimental-strip-types checks/task-continuity.check.ts",
    "check:lobe-ui": "node --experimental-strip-types checks/lobe-ui-integration.check.ts",
    "check:composer-layout": "node --experimental-strip-types checks/composer-layout.check.ts",
    "e2e": "playwright test",
    "preview": "vite preview",
    "tauri:dev": "CARGO_HOME=$PWD/.cargo-home tauri dev",
    "tauri:build": "CARGO_HOME=$PWD/.cargo-home tauri build",
    "tauri:check": "cd src-tauri && CARGO_HOME=$PWD/../.cargo-home cargo check"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@ant-design/x": "^2.8.0",
    "@ant-design/x-markdown": "^2.8.0",
    "@ant-design/x-sdk": "^2.8.0",
    "@lobehub/fluent-emoji": "^4.1.0",
    "@lobehub/icons": "^5.14.0",
    "@lobehub/ui": "5.22.3",
    "@tanstack/react-query": "^5.85.5",
    "@tauri-apps/api": "^2.8.0",
    "antd": "^6.5.1",
    "antd-style": "^4.1.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "motion": "^12.42.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "vite": "^7.1.2"
  },
  "volta": {
    "node": "22.17.0"
  }
}
