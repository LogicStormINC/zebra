# Application-only values. Start the dependency stack separately with docker/.env.
# The database host is the Compose service name, not localhost.

ZEBRA_APPLICATION_NETWORK=zebra-dependencies
# Application Compose defaults to the API-confirmed mirror below. Set this to
# the pinned Docker Hub digest when the upstream registry is reachable.
# ZEBRA_APPLICATION_PYTHON_BASE_IMAGE=python:3.12-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b
ZEBRA_PROFILE=cloud
ZEBRA_DATABASE_URL=postgresql://zebra:local-only-change-me@postgres:5432/zebra
ZEBRA_DEPLOYMENT_NAMESPACE=local-zebra
ZEBRA_AUTHORITY_ISSUER=local-zebra-authority
ZEBRA_HISTORY_SCOPE_NAMESPACE=local-zebra-history
ZEBRA_CONTINUATION_SCOPE_NAMESPACE=local-zebra-continuation
ZEBRA_MEMORY_CURSOR_SIGNING_KEY=local-only-change-me-memory-cursor-signing-key-32

ZEBRA_S3_ENDPOINT=http://minio:9000
ZEBRA_S3_BUCKET=zebra-artifacts
ZEBRA_S3_ACCESS_KEY=zebra-local
ZEBRA_S3_SECRET_KEY=local-only-change-me-too
ZEBRA_S3_REGION=us-east-1
ZEBRA_S3_KEY_PREFIX=zebra/artifacts/v1
ZEBRA_LIVE_REDIS_URL=redis://redis-live:6379/0
ZEBRA_LIVE_STREAM_MAX_LENGTH=1000
ZEBRA_LIVE_STREAM_KEY_PREFIX=zebra:live:v1

ZEBRA_API_PORT=18080
ZEBRA_API_AUTH_TOKEN=
ZEBRA_WORKER_ID=local-zebra-worker
# Supplementary group owning /var/run/docker.sock inside the Worker container.
# Resolve it from the actual mounted socket; do not assume the host docker group.
ZEBRA_DOCKER_SOCKET_GID=0

# Client Integration Plane. The operator token is used only by zebra-api to
# publish immutable frontend profiles; it is not exposed to the Worker.
ZEBRA_CLIENT_INTEGRATION_ENABLED=false
ZEBRA_PLATFORM_OPERATOR_TOKEN=
# Public system CA is the default. Supply per-service SSL_CERT_FILE overrides
# and an explicit CA bind mount overlay for private Host Grant/JWKS issuers.

# Scheduler is opt-in: docker compose ... --profile scheduler up -d zebra-scheduler
# All authority settings are validated at startup; blanks fail closed.
ZEBRA_SCHEDULER_ID=zebra-scheduler
ZEBRA_SCHEDULER_WORKLOAD_IDENTITY=zebra-scheduler
ZEBRA_SCHEDULER_GRANT_EXCHANGE_PROTOCOL=generic
ZEBRA_SCHEDULER_GRANT_EXCHANGE_URL=
ZEBRA_SCHEDULER_WORKLOAD_SHARED_SECRET=
ZEBRA_SCHEDULER_GRANT_ISSUER=
ZEBRA_SCHEDULER_GRANT_AUDIENCE=zebra
ZEBRA_SCHEDULER_GRANT_JWKS_URI=
ZEBRA_SCHEDULER_ALLOWED_ORIGINS=

# Required runtime isolation. Select an installed runtime and a real pinned image.
ZEBRA_RUNTIME_CLASS=gvisor
ZEBRA_RUNTIME_IMAGE=
ZEBRA_RUNTIME_REQUIRE_WORKSPACE_QUOTA=true
# Local VM overlay also requires explicit client certificates:
# ZEBRA_LOCAL_GVISOR_CLIENT_CERT_DIR=/absolute/path/to/engine/client-certificates

# New Host discovery requires explicit resourceBindings on every tool (including []).
ZEBRA_HOST_MANIFEST_BINDING_POLICY=declared
