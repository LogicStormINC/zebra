# Local dependency-stack values only. Copy this file to docker/.env and replace
# every local-only credential and secret before starting the stack. Generate
# suitable local values with `openssl rand -hex 32`. Never commit docker/.env.

ZEBRA_POSTGRES_DB=zebra
ZEBRA_POSTGRES_USER=zebra
ZEBRA_POSTGRES_PASSWORD=local-only-change-me
ZEBRA_POSTGRES_PORT=15432

ZEBRA_REDIS_LIVE_PORT=16379

ZEBRA_MINIO_ROOT_USER=zebra-local
ZEBRA_MINIO_ROOT_PASSWORD=local-only-change-me-too
ZEBRA_MINIO_BUCKET=zebra-artifacts
ZEBRA_MINIO_API_PORT=19000
ZEBRA_MINIO_CONSOLE_PORT=19001

# Mem0 is an opt-in derived-memory profile with its own PostgreSQL database.
# The committed model-key sentinel is enough for health checks only. Replace it
# with a disposable real key before the separately gated write/search Spike.
ZEBRA_MEM0_POSTGRES_DB=mem0
ZEBRA_MEM0_POSTGRES_USER=mem0
ZEBRA_MEM0_POSTGRES_PASSWORD=local-only-change-me-mem0
ZEBRA_MEM0_POSTGRES_PORT=15433
ZEBRA_MEM0_COLLECTION_NAME=zebra_memories
ZEBRA_MEM0_API_PORT=18088
ZEBRA_MEM0_ADMIN_API_KEY=local-only-mem0-admin-key
ZEBRA_MEM0_JWT_SECRET=local-only-mem0-jwt-secret-change-me
ZEBRA_MEM0_OPENAI_API_KEY=mem0-healthcheck-only
ZEBRA_MEM0_LLM_MODEL=gpt-4.1-nano-2025-04-14
ZEBRA_MEM0_EMBEDDER_MODEL=text-embedding-3-small
