# TLS termination for the Trench acceptance environment.
# Certificates are pre-generated by trench-acceptance-bootstrap.sh so that
# callers can pin the same CA from the host without importing Caddy's CA.

https://zebra.zebra.local:8443 {
	tls /certs/tls.crt /certs/tls.key
	reverse_proxy zebra-api:8000 {
		flush_interval -1
	}
}

https://broker.zebra.local:8443 {
	tls /certs/tls.crt /certs/tls.key
	reverse_proxy trench-grant-broker:8090 {
		flush_interval -1
	}
}

https://trench.zebra.local:8443 {
	tls /certs/tls.crt /certs/tls.key
	reverse_proxy {$TRENCH_UPSTREAM:host.docker.internal:8000} {
		flush_interval -1
	}
}
