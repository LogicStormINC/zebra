        "environment": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Environment",
          "type": "string"
        },
        "target_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "deployment_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Deployment Id",
          "type": "string"
