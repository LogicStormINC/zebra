          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "binding": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Binding",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Arguments",
          "type": "object"
        },
        "expected": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Expected",
          "type": "object"
        }
      },
      "required": [
        "name",
        "binding",
        "arguments",
        "expected"
      ],
      "title": "ScriptEvalCase",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "cloud-agent.native-script-evaluation/1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/BundleScope"
    },
    "definition_id": {
      "format": "uuid",
      "title": "Definition Id",
      "type": "string"
    },
    "version_id": {
      "format": "uuid",
      "title": "Version Id",
      "type": "string"
    },
    "definition_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Definition Digest",
      "type": "string"
    },
    "assembly_digest": {
      "title": "Assembly Digest",
      "type": "string"
    },
    "evaluator_actor": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Evaluator Actor",
      "type": "string"
    },
    "policy_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/ScriptEvalCase"
      },
      "maxLength": 32,
      "minLength": 1,
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "scope",
    "definition_id",
    "version_id",
    "definition_digest",
    "assembly_digest",
    "evaluator_actor",
    "policy_version",
    "cases"
