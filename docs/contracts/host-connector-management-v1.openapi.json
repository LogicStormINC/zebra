{
  "openapi": "3.1.0",
  "info": {
    "title": "Native scoped Host connector management",
    "version": "1.0.0"
  },
  "security": [
    {
      "hostManagementBearer": []
    }
  ],
  "paths": {
    "/management/v1/host-connector": {
      "get": {
        "operationId": "readHostConnector",
        "description": "Current scoped Host approval plus explicit connector.read/write action and operator-approved fixed template required. PUT publishes+binds only when active=true; active=false disables the actual binding without publication/repointing. Unknown commit503 requires exact authenticated replay/current GET, never blind new writes. No queries/cookies/duplicate headers; no-store. CORS preflight outside handler.",
        "parameters": [
          {
            "name": "X-Runtime-Deployment",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Runtime-Audience",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Runtime-Product",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Runtime-Environment",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Runtime-Trust-Revision",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current GET or original idempotent PUT snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_ARGUMENT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "SCOPE_MISMATCH or PERMISSION_DENIED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "CONFLICT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED; Retry-After:1",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "MANAGEMENT_UNAVAILABLE; commit outcome may be unknown, reconcile before new writes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Handler METHOD_NOT_ALLOWED; Allow:GET,PUT. Full-app CORS preflight is handled separately with200/400 and no registry facts."
          }
        }
      },
      "put": {
        "operationId": "applyHostConnector",
        "description": "Current scoped Host approval plus explicit connector.read/write action and operator-approved fixed template required. PUT publishes+binds only when active=true; active=false disables the actual binding without publication/repointing. Unknown commit503 requires exact authenticated replay/current GET, never blind new writes. No queries/cookies/duplicate headers; no-store. CORS preflight outside handler.",
        "parameters": [
          {
            "name": "X-Runtime-Deployment",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Runtime-Audience",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Runtime-Product",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Runtime-Environment",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Runtime-Trust-Revision",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current GET or original idempotent PUT snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_ARGUMENT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "SCOPE_MISMATCH or PERMISSION_DENIED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "CONFLICT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED; Retry-After:1",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "MANAGEMENT_UNAVAILABLE; commit outcome may be unknown, reconcile before new writes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Handler METHOD_NOT_ALLOWED; Allow:GET,PUT. Full-app CORS preflight is handled separately with200/400 and no registry facts."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Apply"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "hostManagementBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "rthm_ service credential requires connector actions and current shared Host approval; no automatic B1 grant"
      }
    },
    "schemas": {
      "Apply": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expectedRevision",
          "operationId",
          "active"
        ],
        "properties": {
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740990
          },
          "operationId": {
            "type": "string",
            "format": "uuid",
            "description": "Canonical lowercase hyphenated UUID; reuse exact payload to reconcile a lost response."
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string"
              }
            }
          }
        }
      },
      "Snapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractVersion",
          "binding",
          "profile",
          "approvedProfile",
          "revision",
          "replayed"
        ],
        "properties": {
          "contractVersion": {
            "const": "host-connector-management/1"
          },
          "binding": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Binding"
              },
              {
                "type": "null"
              }
            ]
          },
          "profile": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Profile"
              },
              {
                "type": "null"
              }
            ]
          },
          "approvedProfile": {
            "$ref": "#/components/schemas/Profile"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "replayed": {
            "type": "boolean",
            "description": "Original committed snapshot, not current state; GET reconciles."
          }
        }
      },
      "Binding": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hostAppId",
          "namespaceId",
          "connectorId",
          "profileRevision",
          "bindingRevision",
          "active"
        ],
        "properties": {
          "hostAppId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "namespaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "connectorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "profileRevision": {
            "type": "integer",
            "minimum": 1
          },
          "bindingRevision": {
            "type": "integer",
            "minimum": 1
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "Profile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hostAppId",
          "connectorId",
          "baseUri",
          "manifestPath",
          "invokePathTemplate",
          "workloadIdentityRef",
          "credentialRef",
          "profileRevision",
          "reconcilePathTemplate",
          "supportedProtocolVersions",
          "networkPolicyRef",
          "manifestBindingPolicy",
          "status",
          "profileDigest"
        ],
        "properties": {
          "hostAppId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "connectorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "baseUri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "manifestPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "invokePathTemplate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "workloadIdentityRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "credentialRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "profileRevision": {
            "type": "integer",
            "minimum": 1
          },
          "reconcilePathTemplate": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          },
          "supportedProtocolVersions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "networkPolicyRef": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          },
          "manifestBindingPolicy": {
            "enum": [
              "declared",
              "legacy",
              null
            ]
          },
          "status": {
            "enum": [
              "published",
              "deprecated",
              "revoked"
            ]
          },
          "profileDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
