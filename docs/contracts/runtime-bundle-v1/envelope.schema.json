        },
        "lifecycle": {
          "$ref": "#/$defs/PinnedDomain"
        },
        "memory": {
          "$ref": "#/$defs/PinnedDomain"
        },
        "model": {
          "$ref": "#/$defs/ModelDomain"
        },
        "native": {
          "$ref": "#/$defs/PinnedDomain"
        },
        "operations": {
          "$ref": "#/$defs/PinnedDomain"
        },
        "policy": {
          "$ref": "#/$defs/PinnedDomain"
        },
        "sandbox": {
          "$ref": "#/$defs/PinnedDomain"
        },
        "storage": {
          "$ref": "#/$defs/PinnedDomain"
        },
        "tools": {
          "$ref": "#/$defs/PinnedDomain"
        },
        "transport": {
          "$ref": "#/$defs/PinnedDomain"
        },
        "triggers": {
          "$ref": "#/$defs/PinnedDomain"
        },
        "verification": {
          "$ref": "#/$defs/PinnedDomain"
        }
      },
      "required": [
        "engine",
        "execution",
        "model",
        "instructions",
        "context",
        "memory",
        "content",
        "native",
        "addons",
        "tools",
        "lifecycle",
        "policy",
        "sandbox",
        "storage",
        "transport",
        "frontend",
        "triggers",
        "budget",
        "verification",
        "operations"
      ],
      "title": "RuntimeDomains",
      "type": "object"
    }
