          "maxLength": 256,
          "minLength": 1,
          "title": "Deployment Id",
          "type": "string"
        },
        "environment": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Environment",
          "type": "string"
        },
        "namespace_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Namespace Id",
          "type": "string"
        },
        "product_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "target_id": {
