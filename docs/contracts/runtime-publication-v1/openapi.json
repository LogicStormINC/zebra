              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Runtime-Operation",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Exact durable receipt",
            "content": {
              "application/json": {
                "schema": {
