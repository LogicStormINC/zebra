  "components": {
    "securitySchemes": {
      "Publisher": {
        "type": "http",
        "scheme": "bearer",
        "description": "Distinct rtpub_ credential, private scoped approval and current shared PostgreSQL approval required."
      }
    },
    "schemas": {
      "Request": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "operationId",
              "expectedRevision",
              "versionId",
              "version",
              "bundle"
            ],
            "properties": {
              "action": {
                "const": "materialize"
              },
              "operationId": {
                "type": "string",
                "format": "uuid"
              },
              "expectedRevision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740990
              },
              "versionId": {
                "type": "string",
                "format": "uuid"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "bundle": {
                "type": "object",
                "description": "Native runtime-bundle/1 envelope; validated by the producer parser and approved execution catalog."
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "operationId",
              "expectedRevision",
              "versionId",
              "evidenceId"
            ],
            "properties": {
              "action": {
                "const": "publish"
              },
              "operationId": {
                "type": "string",
                "format": "uuid"
              },
              "expectedRevision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740990
              },
              "versionId": {
                "type": "string",
                "format": "uuid"
              },
              "evidenceId": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        ]
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractVersion",
          "scope",
          "trustRevision",
          "result"
        ],
        "properties": {
          "contractVersion": {
            "const": "runtime-publication/1"
          },
          "scope": {
            "type": "object",
            "required": [
              "authority_issuer",
              "namespace_id",
              "product_id",
              "environment",
              "target_id",
              "deployment_id"
            ],
            "additionalProperties": false,
            "properties": {
              "authority_issuer": {
                "type": "string"
              },
              "namespace_id": {
                "type": "string"
              },
              "product_id": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              },
              "target_id": {
                "type": "string"
              },
              "deployment_id": {
                "type": "string"
              }
            }
          },
          "trustRevision": {
            "type": "integer",
            "minimum": 1
          },
          "result": {
            "type": "object",
            "description": "Durable historical operation receipt; never proof that this Release is still effective.",
            "required": [
              "action",
              "definitionId",
              "versionId",
              "definitionDigest",
              "bundleDigest",
              "assemblyDigest",
              "operationId",
              "revision",
              "inputDigest"
            ],
            "additionalProperties": false,
            "properties": {
              "action": {
                "type": "string"
              },
              "definitionId": {
                "type": "string"
              },
              "versionId": {
                "type": "string"
              },
              "definitionDigest": {
                "type": "string"
              },
              "bundleDigest": {
                "type": "string"
              },
              "assemblyDigest": {
                "type": "string"
              },
              "operationId": {
                "type": "string"
              },
              "inputDigest": {
                "type": "string"
              },
              "releaseId": {
                "type": "string"
              },
              "evidenceId": {
                "type": "string"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "releaseRevision": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
