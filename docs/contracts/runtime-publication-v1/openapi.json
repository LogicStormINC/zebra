            }
          },
          {
            "in": "header",
            "name": "X-Runtime-Product",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Runtime-Environment",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
