              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Runtime-Product",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Runtime-Environment",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Runtime-Trust-Revision",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Exact durable receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "Fixed nonsecret failure; 5xx/transport failures have unknown write outcome."
          },
          "401": {
            "description": "Fixed nonsecret failure; 5xx/transport failures have unknown write outcome."
          },
          "403": {
            "description": "Fixed nonsecret failure; 5xx/transport failures have unknown write outcome."
          },
          "404": {
            "description": "Fixed nonsecret failure; 5xx/transport failures have unknown write outcome."
          },
          "405": {
            "description": "Fixed nonsecret failure; 5xx/transport failures have unknown write outcome."
          },
          "409": {
            "description": "Fixed nonsecret failure; 5xx/transport failures have unknown write outcome."
          },
          "422": {
            "description": "Fixed nonsecret failure; 5xx/transport failures have unknown write outcome."
          },
          "429": {
            "description": "Fixed nonsecret failure; 5xx/transport failures have unknown write outcome."
          },
          "503": {
            "description": "Fixed nonsecret failure; 5xx/transport failures have unknown write outcome."
