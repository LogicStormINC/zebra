OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DATABASE_URL=
REDIS_URL=
GITHUB_TOKEN=
ZEBRA_SCM_PROVIDER=local-only
ZEBRA_GITHUB_OWNER=
ZEBRA_GITHUB_REPO=
ZEBRA_GITHUB_TOKEN_ENV=GITHUB_TOKEN
ZEBRA_GITHUB_API_BASE_URL=https://api.github.com
ZEBRA_SCM_PULL_REQUEST_DRY_RUN=true
ZEBRA_WEB_SEARCH_ENDPOINT=
ZEBRA_SKILL_ROOTS=
ZEBRA_MCP_SERVERS=
ZEBRA_RUNTIME_CLASS=trusted-local
ZEBRA_RUNTIME_ENGINE=docker
ZEBRA_GVISOR_RUNTIME=runsc
# Hard runtimes require an immutable reference such as registry/image@sha256:...
ZEBRA_RUNTIME_IMAGE=
ZEBRA_RUNTIME_CPUS=2
ZEBRA_RUNTIME_MEMORY_MB=2048
ZEBRA_RUNTIME_PIDS=256
ZEBRA_RUNTIME_TMPFS_MB=512
ZEBRA_RUNTIME_MAX_OUTPUT_BYTES=1048576
ZEBRA_RUNTIME_MAX_EXECUTION_SECONDS=900
ZEBRA_RUNTIME_UID=65532
ZEBRA_RUNTIME_GID=65532
