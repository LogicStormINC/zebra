OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
ZEBRA_DEEPSEEK_WIRE_API=chat_completions
ZEBRA_SESSION_HANDOFF_ENABLED=false
ZEBRA_DEEPSEEK_BETA_ENABLED=false
ZEBRA_DEEPSEEK_BETA_BASE_URL=https://api.deepseek.com/beta
ZEBRA_MODEL_MAX_RETRIES=1
ZEBRA_DEEPSEEK_EXECUTOR_PROFILE=deepseek-v4-flash-executor-v1
ZEBRA_DEEPSEEK_PLANNER_PROFILE=deepseek-v4-pro-planner-v1
ZEBRA_DEEPSEEK_REVIEWER_PROFILE=deepseek-v4-pro-reviewer-v1
ZEBRA_DEEPSEEK_SUMMARIZER_PROFILE=deepseek-v4-flash-fast-v1
ZEBRA_DEEPSEEK_ANALYST_PROFILE=deepseek-v4-flash-reasoning-v1
ZEBRA_DEEPSEEK_CLASSIFIER_PROFILE=deepseek-v4-flash-fast-v1
DATABASE_URL=
REDIS_URL=
ZEBRA_LIVE_REDIS_URL=
ZEBRA_LIVE_STREAM_MAX_LENGTH=1000
ZEBRA_LIVE_STREAM_KEY_PREFIX=zebra:live:v1
GITHUB_TOKEN=
ZEBRA_SCM_PROVIDER=local-only
ZEBRA_GITHUB_OWNER=
ZEBRA_GITHUB_REPO=
ZEBRA_GITHUB_TOKEN_ENV=GITHUB_TOKEN
ZEBRA_GITHUB_API_BASE_URL=https://api.github.com
ZEBRA_SCM_PULL_REQUEST_DRY_RUN=true
ZEBRA_WEB_SEARCH_ENDPOINT=
ZEBRA_SKILL_ROOTS=
ZEBRA_SKILLS_STATE_PATH=.zebra-agent/skills-state.sqlite
ZEBRA_MCP_SERVERS=
# Cloud extension reads; requires current PostgreSQL schema
# and a verified Host Grant with extensions.read. Does not enable execution.
ZEBRA_CLOUD_EXTENSIONS_READ_ENABLED=false
# Cloud extension configuration writes; also requires read
# composition and a verified Host Grant with extensions.manage.
ZEBRA_CLOUD_EXTENSIONS_MANAGE_ENABLED=false
# API credential storage only; does not enable MCP execution. Requires cloud
# reads/manage, current PostgreSQL schema and a read-only operator secret mount.
ZEBRA_CLOUD_MCP_CREDENTIALS_ENABLED=false
# Separately enable management HTTP catalog refresh (never Worker execution).
# Requires automatic credentials above, cloud reads/manage and current schema.
# Synchronous bounded discovery; configure ingress rate/concurrency limits before rollout.
ZEBRA_CLOUD_MCP_REFRESH_ENABLED=false
# Enable on API and Worker together after configuring extension Turn admission,
# Worker recovery and the same mounted MCP key. Uses persisted HTTP catalogs;
# it does not enable stdio or discover tools while answering.
ZEBRA_CLOUD_MCP_WORKER_ENABLED=false
# Absolute secret-store root; never a user-upload or sandbox directory.
# <root>/<handle>.json contains version and Base64-encoded 32-byte master key.
# File must deny group/other access (0400/0600); do not commit secret contents.
ZEBRA_MCP_SECRET_ROOT=
ZEBRA_MCP_KEY_HANDLE=
ZEBRA_MCP_KEY_VERSION=
# Bind currently enabled Skills to accepted cloud message Turns. Requires
# extension reads and PostgreSQL; disabled by default and grants no execution.
ZEBRA_CLOUD_EXTENSION_TURN_ADMISSION_ENABLED=false
# Recover and validate admitted extension snapshots in cloud Workers.
ZEBRA_CLOUD_EXTENSION_WORKER_ENABLED=false
# Expose the recovered frozen Skill snapshot through skills.list/read. Requires
# ZEBRA_CLOUD_EXTENSION_WORKER_ENABLED and PostgreSQL cloud composition.
ZEBRA_CLOUD_SKILL_WORKER_ENABLED=false
# Opt-in cloud skill package service using existing private S3 storage.
# Requires reads and current PostgreSQL schema; uploads also require manage.
ZEBRA_CLOUD_SKILLS_PUBLISH_ENABLED=false
# JSON object: {"name": {"command": "/abs/exec", "args": [...]}} for stdio,
# or {"name": {"kind": "http", "url": "https://host/mcp", "bearer_token_env": "ENV"}}
# for Streamable HTTP (https only; bearer token read from env at call time).
ZEBRA_MCP_ELICITATION=true
ZEBRA_RUNTIME_CLASS=trusted-local
ZEBRA_RUNTIME_ENGINE=docker
ZEBRA_GVISOR_RUNTIME=runsc
# OCI/gVisor require an immutable reference; os-sandbox does not use an image.
ZEBRA_RUNTIME_IMAGE=
ZEBRA_RUNTIME_CPUS=2
ZEBRA_RUNTIME_MEMORY_MB=2048
ZEBRA_RUNTIME_PIDS=256
ZEBRA_RUNTIME_TMPFS_MB=512
ZEBRA_RUNTIME_MAX_OUTPUT_BYTES=1048576
ZEBRA_RUNTIME_MAX_EXECUTION_SECONDS=900
ZEBRA_RUNTIME_UID=65532
ZEBRA_RUNTIME_GID=65532
# Production requires the Workspace itself to be a dedicated quota mount.
ZEBRA_RUNTIME_REQUIRE_WORKSPACE_QUOTA=false
ZEBRA_RUNTIME_WORKSPACE_QUOTA_MB=10240
# setup-only uses exact HTTPS URLs and hashes; the Agent sandbox remains network=none.
ZEBRA_SETUP_ENABLED=false
ZEBRA_SETUP_COMMAND_JSON=
ZEBRA_SETUP_ALLOWED_DOMAINS=
ZEBRA_SETUP_DEPENDENCIES_JSON=
ZEBRA_SETUP_LOCKFILES=
# Environment variable name only; never put the credential value in this file.
ZEBRA_SETUP_CREDENTIAL_ENV=
ZEBRA_SETUP_MAX_DEPENDENCY_BYTES=134217728
