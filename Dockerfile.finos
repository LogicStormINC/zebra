FROM python:3.12-slim

ENV HOME=/tmp \
    ZEBRA_DATABASE_URL=/data/sessions.sqlite \
    ZEBRA_TASK_WORKSPACE_ROOT=/var/lib/finos/zebra/task-workspaces \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock README.md ./
COPY apps apps
COPY packages packages
COPY scripts scripts

RUN uv sync --frozen --all-packages --group dev

RUN mkdir -p /data /var/lib/finos/zebra \
    && chown 999:999 /data \
    && chown 999:999 /var/lib/finos/zebra

USER 999:999

EXPOSE 8000

CMD ["/app/.venv/bin/uvicorn", "zebra_agent_api.http:create_http_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
