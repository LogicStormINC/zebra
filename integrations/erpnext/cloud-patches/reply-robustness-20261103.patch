diff --git a/deploy/reply_lazy_exports.py b/deploy/reply_lazy_exports.py
new file mode 100644
index 0000000..8b3b0d2
--- /dev/null
+++ b/deploy/reply_lazy_exports.py
@@ -0,0 +1,35 @@
+"""Apply the existing lazy-export pattern to an exact frozen version, not future APIs."""
+import ast
+from pathlib import Path
+
+
+def make_lazy(path, module):
+    path=Path(path);source=path.read_text();tree=ast.parse(source)
+    exports={};public=None
+    for node in tree.body:
+        if isinstance(node,ast.ImportFrom):
+            if node.module=='__future__':continue
+            if not node.module or any(a.name=='*' for a in node.names):raise ValueError('explicit exports required')
+            target='.'*node.level+node.module
+            exports.update({a.asname or a.name:(target,a.name) for a in node.names})
+        elif isinstance(node,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='__all__' for t in node.targets):public=ast.literal_eval(node.value)
+        elif not isinstance(node,ast.Expr) or not isinstance(node.value,ast.Constant) or not isinstance(node.value.value,str):raise ValueError('initializer has behavior; inspect instead of rewriting')
+    if public is None or set(public)-set(exports):raise ValueError('public exports do not match explicit imports')
+    original=path.with_name('_public_exports.py')
+    if original.exists():raise ValueError('export source already exists')
+    original.write_text(source)
+    lines=['"""Public identities stay stable; narrow readers avoid full application bootstrap."""',
+        '# ruff: noqa: F405 -- TYPE_CHECKING exports define public types.',
+        'from importlib import import_module as _import_module','from typing import TYPE_CHECKING',
+        'if TYPE_CHECKING:', '    from ._public_exports import *  # noqa: F403',
+        '__all__ = '+repr(public),'_EXPORTS = '+repr(exports),
+        'def __getattr__(name: str) -> object:',
+        '    if name not in _EXPORTS:',
+        '        raise AttributeError(f"module {__name__!r} has no attribute {name!r}")',
+        '    module, symbol = _EXPORTS[name]',
+        '    value = getattr(_import_module(module, __name__), symbol)',
+        '    globals()[name] = value',
+        '    return value',
+        'def __dir__() -> list[str]:',
+        '    return sorted(set(globals()) | set(__all__))','']
+    path.write_text('\n'.join(lines))
