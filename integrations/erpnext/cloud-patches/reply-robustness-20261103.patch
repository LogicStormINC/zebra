+    subprocess.run(['git', 'apply', '--check', str(ROOT / 'core.patch')], cwd=frozen, check=True)
+    subprocess.run(['git', 'apply', str(ROOT / 'core.patch')], cwd=frozen, check=True)
+    new_paths = json.loads((ROOT / 'new-paths.json').read_text())
+    for path in new_paths:
+        p = frozen / path
+        p.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(ROOT / 'source' / path, p)
+    worker = [(frozen / p, '/app/' + p) for p in patch_paths + new_paths if not p.startswith('apps/api/')]
+    api = [(frozen / p, '/app/' + p) for p in patch_paths + new_paths if p.startswith('apps/api/')]
+    for path in ['apps/worker/src/zebra_agent_worker', 'packages/agent-storage/src/agent_storage',
+                 'packages/agent-storage/src/agent_storage/postgres',
+                 'packages/agent-integrations/src/agent_integrations']:
+        p = frozen / path
+        p.mkdir(parents=True, exist_ok=True)
+        subprocess.run(['docker', 'cp', 'erpnext-full-worker-1:/app/' + path + '/__init__.py', str(p / '__init__.py')], check=True)
+        make_lazy(p / '__init__.py', 'unused')
+        worker.extend((p / name, '/app/' + path + '/' + name) for name in ['__init__.py', '_public_exports.py'])
+    worker.append((ROOT / 'full_workspace_client.py', '/deployment/full_workspace_client.py'))
+    result = {'base': EXPECTED, 'api': build('api', EXPECTED['api'], api),
+              'worker': build('worker', EXPECTED['worker'], worker)}
+    result['helper'] = build('helper', result['worker'], [],
+                            'ENV PYTHONPATH=/deployment:${PYTHONPATH}\nENTRYPOINT ["python", "-m", "full_workspace_proof"]\n')
+    host_root = '/home/frappe/frappe-bench/apps/zebra_erpnext/'
+    host = [(p, host_root + str(p.relative_to(ROOT / 'host'))) for p in (ROOT / 'host').rglob('*') if p.is_file()]
+    result['host'] = build('host', EXPECTED['host'], host)
+    # QA has only offline pytest dependencies; production images never install tools.
+    for name in ['worker', 'api']:
+        directory = ROOT / ('build-qa-' + name)
+        directory.mkdir()
+        overlay = directory / 'pytest-overlay'
+        overlay.mkdir()
+        with tarfile.open(ROOT / 'pytest-pure.tar') as archive:
+            archive.extractall(overlay, filter='data')
+        (directory / 'Dockerfile').write_text('FROM ' + result[name] + '\nCOPY pytest-overlay/ /app/.venv/lib/python3.12/site-packages/\n')
+        with (ROOT / ('build-qa-' + name + '.log')).open('x') as log:
+            subprocess.run(['docker', 'build', '--network=none', '--pull=false', '--label', 'zebra.owner=' + OWNER,
+                            '-t', 'erp-reply-qa-' + name + '-20261103', str(directory)],
+                           stdout=log, stderr=subprocess.STDOUT, check=True,
+                           env={**os.environ, 'DOCKER_BUILDKIT': '0'})
+    (ROOT / 'candidate.json').write_text(json.dumps(result, indent=2))
+    print(json.dumps(result))
+
+
+if __name__ == '__main__':
+    main()
